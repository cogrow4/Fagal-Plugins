{
  "casc_version": "0.1",
  "id": "org.casc.examples.reverb",
  "name": "Fagal Space",
  "version": "2.0.3",
  "vendor": "Fagal Plugins",
  "url": "https://github.com/cogrow4/Fagal-Plugins",
  "description": "Fagal Space — algorithmic reverb. Classic Freeverb topology: 8 parallel damped feedback comb filters per channel feeding 4 series Schroeder allpasses, with stereo width on the wet signal. Just four controls: Size, Damping, Width, Mix.",
  "category": "reverb",
  "features": ["audio-effect", "stereo", "tail"],
  "audio_inputs": [ { "name": "main", "channels": 2 } ],
  "audio_outputs": [ { "name": "main", "channels": 2 } ],
  "midi_input": false,
  "midi_output": false,
  "mpe_support": false,
  "note_ports": [],
  "latency_frames": 0,
  "tail_seconds": 4.0,
  "hard_realtime": true,
  "params": [
    { "id": 0, "name": "Size",    "short_name": "Size", "module": "Reverb", "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 1, "name": "Damping", "short_name": "Damp", "module": "Reverb", "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 2, "name": "Width",   "short_name": "Wid",  "module": "Reverb", "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 3, "name": "Mix",     "short_name": "Mix",  "module": "Reverb", "min": 0.0, "max": 1.0, "default": 0.33, "unit": "%", "flags": ["automatable","modulatable"], "steps": null }
  ],
  "gui": { "type": "html", "entry": "ui.html", "width": 900, "height": 560, "resizable": false }
}
