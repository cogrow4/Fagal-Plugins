{
  "casc_version": "0.1",
  "id": "org.casc.examples.reverb",
  "name": "Fagal Space",
  "version": "2.0.0",
  "vendor": "Fagal Plugins",
  "url": "https://github.com/cogrow4/CASC",
  "description": "Fagal Space — an expansive multi-section reverb. Four independently toggleable engines: an 8-comb/4-allpass Algorithmic late tail, a Diffusion/Grain stage, Modulation/Shimmer LFO motion, and a convolution-style Early Reflections tap bank, with LowCut/HighCut shaping on the wet path. Inspired by Spectral Audio 'Space'.",
  "category": "reverb",
  "features": ["audio-effect", "stereo", "tail"],
  "audio_inputs": [ { "name": "main", "channels": 2 } ],
  "audio_outputs": [ { "name": "main", "channels": 2 } ],
  "midi_input": false,
  "midi_output": false,
  "mpe_support": false,
  "note_ports": [],
  "latency_frames": 0,
  "tail_seconds": 8.0,
  "hard_realtime": true,
  "params": [
    { "id": 0,  "name": "Size",        "short_name": "Size", "module": "Algorithmic", "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 1,  "name": "Decay",       "short_name": "Dcay", "module": "Algorithmic", "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 2,  "name": "Damping",     "short_name": "Damp", "module": "Algorithmic", "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 3,  "name": "Width",       "short_name": "Wid",  "module": "Algorithmic", "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 4,  "name": "Diffusion",   "short_name": "Diff", "module": "Grain",       "min": 0.0, "max": 1.0, "default": 0.4,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 5,  "name": "Mod Rate",    "short_name": "Rate", "module": "Modulation",  "min": 0.0, "max": 1.0, "default": 0.3,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 6,  "name": "Mod Depth",   "short_name": "Dpth", "module": "Modulation",  "min": 0.0, "max": 1.0, "default": 0.25, "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 7,  "name": "Early Level", "short_name": "ERLv", "module": "Early",       "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 8,  "name": "Low Cut",     "short_name": "LoCt", "module": "Output",      "min": 0.0, "max": 1.0, "default": 0.1,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 9,  "name": "High Cut",    "short_name": "HiCt", "module": "Output",      "min": 0.0, "max": 1.0, "default": 0.8,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 10, "name": "Algo On",     "short_name": "Algo", "module": "Algorithmic", "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable"], "steps": 2 },
    { "id": 11, "name": "Grain On",    "short_name": "Grn",  "module": "Grain",       "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable"], "steps": 2 },
    { "id": 12, "name": "Mod On",      "short_name": "Mod",  "module": "Modulation",  "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable"], "steps": 2 },
    { "id": 13, "name": "Early On",    "short_name": "Erly", "module": "Early",       "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "",  "flags": ["automatable"], "steps": 2 },
    { "id": 14, "name": "Mix",         "short_name": "Mix",  "module": "Output",      "min": 0.0, "max": 1.0, "default": 0.33, "unit": "%", "flags": ["automatable","modulatable"], "steps": null }
  ],
  "gui": { "type": "html", "entry": "ui.html", "width": 900, "height": 560, "resizable": false }
}
