{
  "casc_version": "0.1",
  "id": "org.casc.examples.delay",
  "name": "Fagal Echo",
  "version": "2.0.0",
  "vendor": "Fagal Plugins",
  "url": "https://github.com/cogrow4/CASC",
  "description": "Fagal Echo — an expansive pro-grade stereo/ping-pong delay: tone-shaped feedback (low-cut + high-cut), wow/flutter modulation, a musical dual tap, feedback-path saturation, stereo width, and a Freeze/Hold. Live tap visualizer.",
  "category": "delay",
  "features": ["audio-effect", "stereo"],
  "audio_inputs": [ { "name": "main", "channels": 2 } ],
  "audio_outputs": [ { "name": "main", "channels": 2 } ],
  "midi_input": false,
  "midi_output": false,
  "mpe_support": false,
  "note_ports": [],
  "latency_frames": 0,
  "tail_seconds": 3.0,
  "hard_realtime": true,
  "params": [
    { "id": 0,  "name": "Time",       "short_name": "Time", "module": "Delay",      "min": 0.0, "max": 1.0, "default": 0.25, "unit": "ms", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 1,  "name": "Feedback",   "short_name": "FB",   "module": "Delay",      "min": 0.0, "max": 1.0, "default": 0.35, "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 2,  "name": "Mix",        "short_name": "Mix",  "module": "Output",     "min": 0.0, "max": 1.0, "default": 0.35, "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 3,  "name": "Low Cut",    "short_name": "LoCut","module": "Tone",       "min": 0.0, "max": 1.0, "default": 0.10, "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 4,  "name": "High Cut",   "short_name": "HiCut","module": "Tone",       "min": 0.0, "max": 1.0, "default": 0.70, "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 5,  "name": "Mod Rate",   "short_name": "Rate", "module": "Modulation", "min": 0.0, "max": 1.0, "default": 0.25, "unit": "Hz", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 6,  "name": "Mod Depth",  "short_name": "Depth","module": "Modulation", "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 7,  "name": "Saturation", "short_name": "Sat",  "module": "Drive",      "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 8,  "name": "Width",      "short_name": "Width","module": "Output",     "min": 0.0, "max": 1.0, "default": 1.0,  "unit": "%",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 9,  "name": "Ping-Pong",  "short_name": "Ping", "module": "Routing",    "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "",   "flags": ["automatable"],               "steps": 2 },
    { "id": 10, "name": "Freeze",     "short_name": "Frz",  "module": "Routing",    "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "",   "flags": ["automatable"],               "steps": 2 },
    { "id": 11, "name": "Tap 2 Level","short_name": "Tap2", "module": "Delay",      "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%",  "flags": ["automatable","modulatable"], "steps": null }
  ],
  "gui": { "type": "html", "entry": "ui.html", "width": 900, "height": 560, "resizable": false }
}
