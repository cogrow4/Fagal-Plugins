{
  "casc_version": "0.1",
  "id": "org.casc.examples.synth",
  "name": "Polymath",
  "version": "2.0.0",
  "vendor": "Fagal Plugins",
  "url": "https://github.com/cogrow4/Fagal-Plugins",
  "description": "Polymath — Omnisphere-style deep synth. 8-voice polyphony, dual oscillators with detune, sub and noise layer, 4-mode filter with drive and envelope, dual ADSRs (amp + mod), 2 LFOs with cross-modulation (LFO1 to filter, LFO2 to pitch), built-in FX (chorus + delay + reverb), and an arpeggiator. Big browser UI with oscilloscope, envelope, and LFO visualizers.",
  "category": "synth",
  "features": ["instrument", "stereo", "polyphonic", "arpeggiator", "fx"],
  "audio_inputs": [],
  "audio_outputs": [ { "name": "main", "channels": 2 } ],
  "midi_input": true,
  "midi_output": false,
  "mpe_support": false,
  "note_ports": [ { "name": "notes", "mpe": false } ],
  "latency_frames": 0,
  "tail_seconds": 2.0,
  "hard_realtime": true,
  "params": [
    { "id": 0,  "name": "Osc1 Wave",    "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "",  "flags": ["automatable","stepped"], "steps": 4 },
    { "id": 1,  "name": "Osc1 Level",   "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.7,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 2,  "name": "Osc1 Detune",  "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 3,  "name": "Osc2 Wave",    "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.33, "unit": "",  "flags": ["automatable","stepped"], "steps": 4 },
    { "id": 4,  "name": "Osc2 Level",   "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.6,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 5,  "name": "Osc2 Detune",  "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 6,  "name": "Sub",          "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.3,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 7,  "name": "Noise",        "module": "Osc",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 8,  "name": "Cutoff",       "module": "Filter",  "min": 0.0, "max": 1.0, "default": 0.65, "unit": "Hz", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 9,  "name": "Resonance",    "module": "Filter",  "min": 0.0, "max": 1.0, "default": 0.20, "unit": "",  "flags": ["automatable","modulatable"], "steps": null },
    { "id": 10, "name": "Type",         "module": "Filter",  "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "",  "flags": ["automatable","stepped"], "steps": 4 },
    { "id": 11, "name": "Drive",        "module": "Filter",  "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 12, "name": "Env Amount",   "module": "Filter",  "min": 0.0, "max": 1.0, "default": 0.4,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 13, "name": "Attack",       "module": "AmpEnv",  "min": 0.0, "max": 1.0, "default": 0.05, "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 14, "name": "Decay",        "module": "AmpEnv",  "min": 0.0, "max": 1.0, "default": 0.3,  "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 15, "name": "Sustain",      "module": "AmpEnv",  "min": 0.0, "max": 1.0, "default": 0.7,  "unit": "",  "flags": ["automatable"], "steps": null },
    { "id": 16, "name": "Release",      "module": "AmpEnv",  "min": 0.0, "max": 1.0, "default": 0.3,  "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 17, "name": "Mod Atk",      "module": "ModEnv",  "min": 0.0, "max": 1.0, "default": 0.1,  "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 18, "name": "Mod Dec",      "module": "ModEnv",  "min": 0.0, "max": 1.0, "default": 0.3,  "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 19, "name": "Mod Sus",      "module": "ModEnv",  "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable"], "steps": null },
    { "id": 20, "name": "Mod Rel",      "module": "ModEnv",  "min": 0.0, "max": 1.0, "default": 0.4,  "unit": "s", "flags": ["automatable"], "steps": null },
    { "id": 21, "name": "LFO1 Rate",    "module": "LFO",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "Hz", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 22, "name": "LFO1 Depth",   "module": "LFO",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 23, "name": "LFO2 Rate",    "module": "LFO",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "Hz", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 24, "name": "LFO2 Depth",   "module": "LFO",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 25, "name": "FX Mix",       "module": "FX",      "min": 0.0, "max": 1.0, "default": 0.25, "unit": "%", "flags": ["automatable"], "steps": null },
    { "id": 26, "name": "Master",       "module": "Output",  "min": 0.0, "max": 1.0, "default": 0.8,  "unit": "%", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 27, "name": "Arp On",       "module": "Arp",     "min": 0.0, "max": 1.0, "default": 0.0,  "unit": "",  "flags": ["automatable"], "steps": 2 },
    { "id": 28, "name": "Arp Rate",     "module": "Arp",     "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "Hz", "flags": ["automatable","modulatable"], "steps": null },
    { "id": 29, "name": "Arp Gate",     "module": "Arp",     "min": 0.0, "max": 1.0, "default": 0.5,  "unit": "",  "flags": ["automatable","modulatable"], "steps": null }
  ],
  "gui": { "type": "html", "entry": "ui.html", "width": 1100, "height": 720, "resizable": false }
}
